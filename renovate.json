{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "gomod",
    "github-actions"
  ],
  "prConcurrentLimit": 5,
  "labels": [
    "dependencies"
  ],
  "gomod": {
    "postUpdateOptions": [
      "gomodTidy"
    ]
  },
  "postUpgradeTasks": {
    "commands": [
      "go run ./cmd/relock"
    ],
    "fileFilters": [
      "schemas/capture.lock.json"
    ],
    "executionMode": "branch"
  }
}
